# IR Program

function factorial: int (n: int)
factorial_entry:  # ENTRY
  t0 = ALLOCA 4  # param n
  PARAM 0, t1  # load param 0
  STORE [t0], t1
  t2 = LOAD [t0]  # load n
  t3 = LE t2, 1  # t2 <= 1
  JUMP_IF t3, L_then0  # if condition
L_else1:
  t4 = LOAD [t0]  # load n
  t5 = LOAD [t0]  # load n
  t6 = SUB t5, 1  # t5 - 1
  t7 = CALL factorial(t6)  # call factorial
  t8 = MUL t4, t7  # t4 * t7
  RETURN t8  # return value
L_then0:
  RETURN 1  # return value
L_join2:  # JOIN
  RETURN  # implicit return

function sum: int (a: int, b: int)
sum_entry:  # ENTRY
  t0 = ALLOCA 4  # param a
  PARAM 0, t1  # load param 0
  STORE [t0], t1
  t2 = ALLOCA 4  # param b
  PARAM 1, t3  # load param 1
  STORE [t2], t3
  t4 = LOAD [t0]  # load a
  t5 = LOAD [t2]  # load b
  t6 = ADD t4, t5  # t4 + t5
  RETURN t6  # return value

function main: void ()
main_entry:  # ENTRY
  STORE [x], 5  # init x
  STORE [y], 10  # init y
  STORE [result], 0  # init result
  t0 = LOAD [x]  # load x
  t1 = CALL factorial(t0)  # call factorial
  STORE [result], t1  # store result
  STORE [i], 0  # init i
  JUMP L_while_header0
L_while_header0:  # LOOP_HEADER
  t2 = LOAD [i]  # load i
  t3 = LOAD [y]  # load y
  t4 = LT t2, t3  # t2 < t3
  JUMP_IF t4, L_while_body1  # while condition
L_while_exit2:
  t10 = LOAD [result]  # load result
  t11 = GT t10, 100  # t10 > 100
  JUMP_IF t11, L_then3  # if condition
L_while_body1:  # LOOP_BODY
  t5 = LOAD [result]  # load result
  t6 = LOAD [i]  # load i
  t7 = CALL sum(t5, t6)  # call sum
  STORE [result], t7  # store result
  t8 = LOAD [i]  # load i
  t9 = ADD t8, 1  # t8 + 1
  STORE [i], t9  # store i
  JUMP L_while_header0
L_else4:
  STORE [result], 0  # store result
  JUMP L_join5
L_then3:
  STORE [result], 100  # store result
  JUMP L_join5
L_join5:  # JOIN
  RETURN
