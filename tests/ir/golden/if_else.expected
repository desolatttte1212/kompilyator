# IR Program

function max: int (a: int, b: int)
max_entry:  # ENTRY
  t0 = ALLOCA 4  # param a
  PARAM 0, t1  # load param 0
  STORE [t0], t1
  t2 = ALLOCA 4  # param b
  PARAM 1, t3  # load param 1
  STORE [t2], t3
  t4 = LOAD [t0]  # load a
  t5 = LOAD [t2]  # load b
  t6 = GT t4, t5  # t4 > t5
  JUMP_IF t6, L_then0  # if condition
L_else1:
  t7 = LOAD [t2]  # load b
  RETURN t7  # return value
L_then0:
  t8 = LOAD [t0]  # load a
  RETURN t8  # return value
L_join2:  # JOIN
  RETURN  # implicit return
