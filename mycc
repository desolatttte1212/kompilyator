#!/usr/bin/env python3
"""
mycc — Unix-style wrapper for MiniCompiler
Usage: ./mycc [command] [options] <sourcefile>
"""
import sys
import os
from pathlib import Path

# Добавляем корень проекта в путь, чтобы работали импорты
project_root = Path(__file__).resolve().parent
if str(project_root) not in sys.path:
    sys.path.insert(0, str(project_root))

# Импортируем main из пакета
from src.main import main as compiler_main

if __name__ == '__main__':
    sys.exit(compiler_main())